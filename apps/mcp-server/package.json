{
  "name": "@tamiz/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tamiz MCP server: read-only tools over the gateway's simulate and admin API (stdio and streamable HTTP)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tamiz-mcp": "./dist/main.js"
  },
  "exports": {
    "./agent/fixture-run": {
      "types": "./dist/agent/fixture-run.d.ts",
      "import": "./dist/agent/fixture-run.js"
    },
    "./agent/json-object": {
      "types": "./dist/agent/json-object.d.ts",
      "import": "./dist/agent/json-object.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:http": "node dist/main.js --transport http",
    "agent:demo": "node dist/agent/demo.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@tamiz/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/mcp": "1.0.100",
    "@ai-sdk/openai-compatible": "^2.0.88",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tamiz/contracts": "workspace:*",
    "ai": "^6.0.319",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
